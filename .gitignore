# Dependencies and build outputs
node_modules/
dist/
packages/*/dist/
packages/opencode/src/tui-compiled/
packages/opencode/src/tui/quota-sidebar.js
*.tsbuildinfo

# Local agent/dev state
.opencode/
.claude/
.pi/

# Fleet layout: internal docs and tool state under .cortexkit/ stay out of git.
# Only release notes, skills, rules and WORKER.md may be tracked there.
/.cortexkit/*
!/.cortexkit/release-notes/
!/.cortexkit/skills/
!/.cortexkit/rules/
!/.cortexkit/WORKER.md

# Editor and OS metadata
.DS_Store
.idea/
.vscode/

# Local environment and machine-specific config
.env
.env.*
!.env.example
mise.local.toml
anthropic-auth.json
anthropic-auth.json.*

# Local databases, logs, dumps, and temporary files
*.db
*.sqlite
*.sqlite3
*.log
*.tmp
*.bak
coverage/
tmp/
temp/
# Local verification captures can include synthetic or credential-derived data.
verification-inputs/

# mitmproxy capture/extract artifacts (local diagnostics)
*.flow
*.flow.log
captures/*.txt
