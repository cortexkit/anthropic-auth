{
  "name": "@cortexkit/anthropic-auth-core",
  "version": "1.23.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortexkit/anthropic-auth.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && bun scripts/build.ts",
    "test": "bun run build && bun test src/tests",
    "test:scripts": "bun test scripts",
    "check:native-type-closure": "bun scripts/check-native-type-closure.ts",
    "typecheck": "tsc",
    "types": "tsc",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@cortexkit/common-auth": "^0.10.0"
  },
  "dependencies": {
    "@cortexkit/claustrum-client": "0.6.2",
    "jsonc-parser": "^3.3.1",
    "xxhash-wasm": "^1.1.0"
  }
}
