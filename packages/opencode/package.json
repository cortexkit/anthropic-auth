{
  "name": "@cortexkit/opencode-anthropic-auth",
  "version": "2.4.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortexkit/anthropic-auth.git",
    "directory": "packages/opencode"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./src/tui/entry.mjs"
    },
    "./server": {
      "types": "./dist/v2/server.d.ts",
      "import": "./dist/v2/server.js"
    },
    "./rpc": {
      "types": "./dist/rpc/rpc-client.d.ts",
      "import": "./dist/rpc/rpc-client.js"
    },
    "./tui-prefs": {
      "types": "./dist/tui-preferences.d.ts",
      "import": "./dist/tui-preferences.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "bin": {
    "opencode-anthropic-auth": "dist/cli.js"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "files": [
    "dist",
    "src/tui.tsx",
    "src/tui",
    "src/tui-compiled",
    "src/sidebar-state.ts",
    "src/tui-preferences.ts",
    "src/rpc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/v2/server.ts src/v2/tui.ts src/cli.ts src/sidebar-state.ts src/tui-preferences.ts src/rpc/rpc-client.ts src/rpc/port-file.ts src/rpc/protocol.ts src/rpc/rpc-dir.ts --outdir dist --root src --target node --format esm --splitting --external @opencode-ai/plugin --external @opencode/plugin --external @cortexkit/anthropic-auth-core --external @cortexkit/private-files --external @cortexkit/claustrum-client --external @cortexkit/subc-client --external xxhash-wasm --external jsonc-parser --minify && tsc -p tsconfig.build.json --emitDeclarationOnly && bun run build:tui && bun run check:bundle",
    "build:tui": "bun scripts/build-tui.ts",
    "smoke:tui": "bun scripts/smoke-tui-pack-install.ts",
    "check:bundle": "bun scripts/check-bundle-globals.ts",
    "build:dev": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "bun ../../scripts/dev.ts",
    "dev:clean": "bun ../../scripts/dev-clean.ts",
    "extract": "bun ../../scripts/extract-system-prompt.ts",
    "test": "bun test src/tests",
    "typecheck": "tsc && tsc -p tsconfig.scripts.json",
    "types": "tsc && tsc -p tsconfig.scripts.json",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode/plugin": ">=2.0.21"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@cortexkit/anthropic-auth-core": "2.4.2",
    "@cortexkit/claustrum-client": "0.13.0",
    "@cortexkit/private-files": "0.2.2",
    "@cortexkit/subc-client": "^0.22.10",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.12",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@opencode/plugin": "2.2.0"
  }
}
