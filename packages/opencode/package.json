{
  "name": "@marcusrbrown/opencode-anthropic-auth",
  "version": "1.2.2-mb.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcusrbrown/cortexkit_anthropic-auth.git",
    "directory": "packages/opencode"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "opencode-anthropic-auth": "dist/cli.js"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/cli.ts --outdir dist --target node --format esm --splitting --external @opencode-ai/plugin --minify && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:dev": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "bun ../../scripts/dev.ts",
    "dev:clean": "bun ../../scripts/dev-clean.ts",
    "extract": "bun ../../scripts/extract-system-prompt.ts",
    "test": "bun test src/tests",
    "typecheck": "tsc",
    "types": "tsc",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "dependencies": {
    "@cortexkit/anthropic-auth-core": "1.2.2"
  }
}
